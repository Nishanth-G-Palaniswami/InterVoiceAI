# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine
AGENT_PROFILE=booking
# Which models: budget | quality   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

# InterviewAI: candidate intake UI + phone agent
# MODEL_PRESET=interview   (Deepgram nova-3 STT for word timings + budget LLM/TTS)
# AGENT_PROFILE=mine       (the InterviewAgent)
# Rented LiveKit number, shown on the intake page as "call this number"
AGENT_PHONE=
# Where candidate profiles and call records are written (default: <repo>/data)
# DATA_DIR=
